import { mkdir, readFile, writeFile } from "node:fs/promises";
import { execFileSync } from "node:child_process";

await mkdir("dist", { recursive: true });

const { build } = await import("esbuild");
await build({
  entryPoints: ["roblox-forge-bridge.js"],
  bundle: true,
  platform: "node",
  format: "cjs",
  target: "node22",
  outfile: "dist/bridge.cjs",
  sourcemap: false,
  minify: false
});

const config = {
  main: "dist/bridge.cjs",
  mainFormat: "commonjs",
  output: "dist/RobloxForgeAI.exe",
  disableExperimentalSEAWarning: true,
  useSnapshot: false,
  useCodeCache: false
};

await writeFile("dist/sea-config.json", JSON.stringify(config, null, 2));
execFileSync(process.execPath, ["--build-sea", "dist/sea-config.json"], { stdio: "inherit" });

console.log("RobloxForgeAI.exe created.");

-- Aizen Cero Animation
-- AAA Quality Animation for RobuNexa

-- Animation Metadata
local metadata = {
    name = "AizenCero",
    duration = 1.0,
    loop = false,
    fps = 60,
    format = "NAMAnimation"
}

-- Animation Tracks
local tracks = {
    {
        name = "AizenCeroTrack",
        keyframes = {
            {time = 0, position = CFrame.new(0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 0, 0)},
            {time = 0.2, position = CFrame.new(1.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 0.5, 0)},
            {time = 0.4, position = CFrame.new(2.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 1.0, 0)},
            {time = 0.6, position = CFrame.new(3.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 1.5, 0)},
            {time = 0.8, position = CFrame.new(4.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 2.0, 0)},
            {time = 1.0, position = CFrame.new(5.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 2.5, 0)},
        }
    }
}

-- Animation Export Function
local function exportAnimation()
    return {
        metadata = metadata,
        tracks = tracks
    }
end

return exportAnimation()
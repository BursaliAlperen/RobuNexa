-- Aizen Shunpo Animation
-- AAA Quality Animation for RobuNexa

-- Animation Metadata
local metadata = {
    name = "AizenShunpo",
    duration = 0.6,
    loop = false,
    fps = 60,
    format = "NAMAnimation"
}

-- Animation Tracks
local tracks = {
    {
        name = "AizenShunpoTrack",
        keyframes = {
            {time = 0, position = CFrame.new(0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 0, 0)},
            {time = 0.1, position = CFrame.new(2.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 1.0, 0)},
            {time = 0.2, position = CFrame.new(4.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 2.0, 0)},
            {time = 0.3, position = CFrame.new(6.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 3.0, 0)},
            {time = 0.4, position = CFrame.new(8.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 4.0, 0)},
            {time = 0.5, position = CFrame.new(10.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 5.0, 0)},
            {time = 0.6, position = CFrame.new(12.0, 0, 0), rotation = CFrame.fromEulerAnglesXYZ(0, 6.0, 0)},
        }
    }
}

-- Animation Export Function
local function exportAnimation()
    return {
        metadata = metadata,
        tracks = tracks
    }
end

return exportAnimation()